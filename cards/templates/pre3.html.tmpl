{% extends "base.html.tmpl" %}
{% block style %}
.title { margin-top: 56px; font-size: 110px; }
.themes { margin-top: 56px; display: flex; flex-direction: column; gap: 18px; position: relative; z-index: 2; }
.theme {
  background: {{ tokens.card_bg }};
  border: 1px solid {{ tokens.card_border }};
  border-radius: 24px;
  padding: 28px 36px;
  display: flex;
  align-items: center;
  gap: 24px;
}
.theme.hot {
  background: linear-gradient(90deg, {{ tokens.hot_bg1 }}, {{ tokens.hot_bg2 }});
  border-color: {{ tokens.hot_border }};
}
.t-num { font-size: 36px; font-weight: 900; color: {{ tokens.text_dim }}; min-width: 56px; }
.theme.hot .t-num { color: {{ tokens.accent }}; }
.t-tag { font-size: 30px; font-weight: 900; color: {{ tokens.accent }}; min-width: 220px; }
.t-stock-name { flex: 1; font-size: 38px; font-weight: 900; letter-spacing: -0.02em; }
.t-stock-rate { font-size: 42px; font-weight: 900; color: {{ tokens.accent2 }}; letter-spacing: -0.02em; min-width: 180px; text-align: right; }
{% endblock %}

{% block content %}
<h1 class="title">{{ data.title_top }} <em>{{ data.title_em }}</em></h1>
<div class="themes">
{% for t in data.themes %}
  <div class="theme{% if t.hot %} hot{% endif %}">
    <span class="t-num">{{ t.rank }}</span>
    <span class="t-tag">#{{ t.tag }}</span>
    {% set lead = t.stocks[0] %}
    <span class="t-stock-name">{{ lead.name }}</span>
    <span class="t-stock-rate">{{ "%+.2f"|format(lead.rate) }}%</span>
  </div>
{% endfor %}
</div>
{% endblock %}
