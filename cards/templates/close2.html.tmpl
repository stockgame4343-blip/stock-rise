{% extends "base.html.tmpl" %}
{% block style %}
/* 핵심 이슈 3장만. 섹터 grid 제거 (한 카드 = 한 메시지) */
.title { margin-top: 24px; font-size: 96px; }
.sub { margin-top: 18px; font-size: 26px; }
.issues { margin-top: 64px; display: flex; flex-direction: column; gap: 22px; position: relative; z-index: 2; }
.issue {
  background: {{ tokens.card_bg }};
  border: 1px solid {{ tokens.card_border }};
  border-radius: 28px;
  padding: 36px 40px;
  display: flex;
  gap: 28px;
  align-items: flex-start;
}
.issue.hot {
  background: linear-gradient(90deg, {{ tokens.hot_bg1 }}, {{ tokens.hot_bg2 }});
  border-color: {{ tokens.hot_border }};
}
.i-num { font-size: 56px; font-weight: 900; color: {{ tokens.text_dim }}; min-width: 80px; line-height: 1; }
.issue.hot .i-num { color: {{ tokens.accent2 }}; }
.i-body { flex: 1; min-width: 0; }
.i-title { font-size: 44px; font-weight: 900; letter-spacing: -0.02em; line-height: 1.1; }
.i-desc { margin-top: 12px; font-size: 22px; color: {{ tokens.muted }}; font-weight: 700; line-height: 1.4; }
{% endblock %}

{% block content %}
<div class="top">
  <span class="label">{{ data.label }}</span>
  <div class="time">{{ data.time_text }}</div>
</div>
<h1 class="title">{{ data.title_top }} <em>{{ data.title_em }}</em></h1>

<div class="issues">
{% for it in data.issues %}
  <div class="issue{% if it.hot %} hot{% endif %}">
    <div class="i-num">{{ it.num }}</div>
    <div class="i-body">
      <div class="i-title">{{ it.title }}</div>
      <div class="i-desc">{{ it.desc }}</div>
    </div>
  </div>
{% endfor %}
</div>
{% endblock %}
