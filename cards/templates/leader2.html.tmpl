{% extends "base.html.tmpl" %}
{% block style %}
.title { margin-top: 56px; font-size: 96px; }
.theme-headline {
  margin-top: 44px;
  display: flex;
  align-items: baseline;
  gap: 28px;
  position: relative;
  z-index: 2;
  flex-wrap: wrap;
}
.theme-name { font-size: 80px; font-weight: 900; color: {{ tokens.accent }}; letter-spacing: -0.03em; line-height: 1; }
.theme-stat { font-size: 36px; color: #fff; font-weight: 800; }
.theme-stat strong { color: {{ tokens.accent2 }}; }
.members { margin-top: 44px; display: flex; flex-direction: column; gap: 14px; position: relative; z-index: 2; }
.mem {
  background: {{ tokens.card_bg }};
  border: 1px solid {{ tokens.card_border }};
  border-radius: 20px;
  padding: 22px 32px;
  display: flex;
  align-items: center;
  gap: 24px;
}
.mem.lead {
  background: linear-gradient(90deg, {{ tokens.hot_bg1 }}, transparent);
  border-color: {{ tokens.hot_border }};
}
.m-rank { font-size: 38px; font-weight: 900; color: {{ tokens.text_dim }}; min-width: 56px; }
.mem.lead .m-rank { color: {{ tokens.accent }}; }
.m-name { flex: 1; font-size: 40px; font-weight: 900; letter-spacing: -0.02em; }
.m-rate { font-size: 44px; font-weight: 900; color: {{ tokens.accent2 }}; letter-spacing: -0.02em; }
{% endblock %}

{% block content %}
<h1 class="title">{{ data.title_top }} <em>{{ data.title_em }}</em></h1>
<div class="theme-headline">
  <span class="theme-name">{{ data.theme_name }}</span>
  <span class="theme-stat">{{ data.theme_stat_html | safe }}</span>
</div>
<div class="members">
{% for m in data.members %}
  <div class="mem{% if m.is_leader %} lead{% endif %}">
    <span class="m-rank">{{ m.rank }}</span>
    <span class="m-name">{{ m.name }}</span>
    <span class="m-rate">{{ "%+.2f"|format(m.rate) }}%</span>
  </div>
{% endfor %}
</div>
{% endblock %}
