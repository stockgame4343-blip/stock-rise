{% extends "base.html.tmpl" %}
{% block style %}
.title { margin-top: 40px; font-size: 108px; }
.indices { margin-top: 50px; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 18px; position: relative; z-index: 2; }
.idx {
  background: {{ tokens.card_bg }};
  border: 1px solid {{ tokens.card_border }};
  border-radius: 24px;
  padding: 28px 24px;
  text-align: center;
}
.idx.up { background: linear-gradient(135deg, rgba(255,107,107,.20), rgba(255,107,107,.04)); border-color: rgba(255,107,107,.45); }
.idx.dn { background: linear-gradient(135deg, rgba(91,157,249,.18), rgba(91,157,249,.03)); border-color: rgba(91,157,249,.4); }
.idx-name { font-size: 22px; color: {{ tokens.muted }}; font-weight: 800; }
.idx-value { margin-top: 10px; font-size: 54px; font-weight: 900; letter-spacing: -0.03em; line-height: 1; }
.idx-pct { margin-top: 10px; font-size: 30px; font-weight: 900; color: #ff8c8c; letter-spacing: -0.02em; }
.idx.dn .idx-pct { color: #7cadff; }
.mood {
  margin-top: 36px;
  padding: 26px 32px;
  background: linear-gradient(90deg, {{ tokens.hot_bg1 }}, transparent);
  border: 1px solid {{ tokens.hot_border }};
  border-radius: 22px;
  position: relative;
  z-index: 2;
}
.mood-text { font-size: 32px; font-weight: 900; letter-spacing: -0.02em; line-height: 1.25; }

.headlines { margin-top: 28px; display: flex; flex-direction: column; gap: 16px; position: relative; z-index: 2; }
.hl {
  background: {{ tokens.card_bg }};
  border: 1px solid {{ tokens.card_border }};
  border-radius: 22px;
  padding: 22px 28px;
  display: grid;
  grid-template-columns: 56px 1fr;
  gap: 16px;
  align-items: start;
}
.hl-num { font-size: 32px; font-weight: 900; color: {{ tokens.accent }}; letter-spacing: -0.04em; line-height: 1.05; }
.hl-body { min-width: 0; }
.hl-title {
  font-size: 28px;
  font-weight: 900;
  letter-spacing: -0.025em;
  line-height: 1.25;
  color: #fff;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.hl-impact {
  margin-top: 6px;
  font-size: 20px;
  font-weight: 700;
  color: {{ tokens.accent2 }};
  letter-spacing: -0.01em;
}
.hl-impact::before { content: '→ '; opacity: .85; }
{% endblock %}

{% block content %}
<h1 class="title">{{ data.title_top }} <em>{{ data.title_em }}</em></h1>
<div class="indices">
{% for i in data.indices %}
  <div class="idx {% if i.up %}up{% else %}dn{% endif %}">
    <div class="idx-name">{{ i.name }}</div>
    <div class="idx-value">{{ "{:,.0f}".format(i.value) }}</div>
    <div class="idx-pct">{{ "%+.2f"|format(i.pct) }}%</div>
  </div>
{% endfor %}
</div>
<div class="mood">
  <div class="mood-text">{{ data.mood_text }}</div>
</div>
{% if data.headlines %}
<div class="headlines">
  {% for h in data.headlines %}
  <div class="hl">
    <div class="hl-num">{{ h.rank }}</div>
    <div class="hl-body">
      <div class="hl-title">{{ h.title }}</div>
      {% if h.impact %}<div class="hl-impact">{{ h.impact }}</div>{% endif %}
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}
{% endblock %}
