{% extends "base.html.tmpl" %}
{% block style %}
.title { margin-top: 14px; font-size: 84px; }
.indices { margin-top: 30px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px; position: relative; z-index: 2; }
.idx {
  background: {{ tokens.card_bg }};
  border: 1px solid {{ tokens.card_border }};
  border-radius: 22px;
  padding: 22px 26px;
}
.idx.up   { background: linear-gradient(135deg, rgba(255,107,107,.18), rgba(255,107,107,.02)); border-color: rgba(255,107,107,.4); }
.idx.flat { background: linear-gradient(135deg, rgba(180,180,180,.1), rgba(180,180,180,.02)); border-color: rgba(180,180,180,.3); }
.idx.dn   { background: linear-gradient(135deg, rgba(91,157,249,.16), rgba(91,157,249,.02)); border-color: rgba(91,157,249,.35); }
.idx-name { font-size: 15px; color: {{ tokens.muted }}; font-weight: 700; letter-spacing: 0.02em; }
.idx-value { margin-top: 8px; font-size: 46px; font-weight: 900; letter-spacing: -0.03em; }
.idx-change-row { margin-top: 4px; display: flex; gap: 12px; align-items: baseline; }
.idx-change { font-size: 22px; font-weight: 800; color: {{ tokens.accent2 }}; }
.idx.flat .idx-change, .idx.dn .idx-change { color: #aaa; }
.idx-pct { font-size: 16px; font-weight: 700; color: #ff9999; }
.idx.flat .idx-pct, .idx.dn .idx-pct { color: #aaa; }
.stats { margin-top: 22px; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; position: relative; z-index: 2; }
.ss {
  background: {{ tokens.card_bg }};
  border: 1px solid {{ tokens.card_border }};
  border-radius: 14px;
  padding: 14px 20px;
}
.ss-label { font-size: 12px; color: {{ tokens.muted }}; font-weight: 700; letter-spacing: 0.02em; }
.ss-value { margin-top: 4px; font-size: 22px; font-weight: 900; letter-spacing: -0.02em; }
.ss-value.up { color: {{ tokens.accent2 }}; }
.ss-value.neutral { color: {{ tokens.accent }}; }
.leader-strip {
  margin-top: 22px;
  padding: 18px 24px;
  background: {{ tokens.card_bg }};
  border: 1px solid {{ tokens.card_border }};
  border-radius: 16px;
  position: relative;
  z-index: 2;
}
.leader-label { font-size: 12px; color: {{ tokens.accent }}; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
.leader-row { margin-top: 8px; display: flex; align-items: center; gap: 14px; }
.leader-icon { font-size: 28px; color: {{ tokens.accent }}; }
.leader-name { font-size: 30px; font-weight: 900; letter-spacing: -0.02em; flex: 1; }
.leader-rate { font-size: 30px; font-weight: 900; color: {{ tokens.accent2 }}; letter-spacing: -0.03em; }
{% endblock %}

{% block content %}
<div class="top">
  <div class="brand"><span class="brand-dot"></span>StockRise · 마감 시황</div>
  <div class="time">{{ data.time_text }}</div>
</div>
<div class="eyebrow">{{ data.eyebrow }}</div>
<h1 class="title">{{ data.title_top }}<br><em>{{ data.title_em }}</em> {{ data.title_bot }}</h1>
<div class="sub">{{ data.sub }}</div>

{% if data.indices %}
<div class="indices">
{% for i in data.indices %}
  <div class="idx {% if i.flat %}flat{% elif i.up %}up{% else %}dn{% endif %}">
    <div class="idx-name">{{ i.name }}</div>
    <div class="idx-value">{{ "{:,.2f}".format(i.value) }}</div>
    <div class="idx-change-row">
      <span class="idx-change">{% if i.up %}▲{% elif i.flat %}―{% else %}▼{% endif %} {{ "{:,.2f}".format(i.change|abs) }}</span>
      <span class="idx-pct">{{ "%+.2f"|format(i.pct) }}%</span>
    </div>
  </div>
{% endfor %}
</div>
{% endif %}

<div class="stats">
{% for s in data.stats %}
  <div class="ss">
    <div class="ss-label">{{ s.label }}</div>
    <div class="ss-value {{ s.kind }}">{{ s.value }}</div>
  </div>
{% endfor %}
</div>

<div class="leader-strip">
  <div class="leader-label">{{ data.leader_label }}</div>
  <div class="leader-row">
    <div class="leader-icon">◆</div>
    <div class="leader-name">{{ data.leader_name }}</div>
    <div class="leader-rate">{{ "%+.1f"|format(data.leader_rate) }}%</div>
  </div>
</div>
{% endblock %}
