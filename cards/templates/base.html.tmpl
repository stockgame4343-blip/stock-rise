{#
  공통 골격. 자식 템플릿이 {% block style %}, {% block content %}만 채움.
  data, tokens 컨텍스트는 renderer.py 가 주입.
#}
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>StockRise · {{ data.date_kr }} · {{ data.series }}</title>
  <link rel="stylesheet" as="style" crossorigin
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
  <style>
{% include "_base.css" %}
/* 시리즈별 컬러 토큰 주입.
 * BG 흰 짤림 방지: html, body, .card 모두 명시 background.
 * .card 가 viewport 외로 밀리거나 캡처 영역이 카드보다 커도 흰색 노출 0.
 */
html, body {
  background: {{ tokens.bg1 }};
  background: linear-gradient(165deg,
    {{ tokens.bg1 }} 0%,
    {{ tokens.bg2 }} 50%,
    {{ tokens.bg3 }} 100%);
}
.card {
  background: linear-gradient(165deg,
    {{ tokens.bg1 }} 0%,
    {{ tokens.bg2 }} 50%,
    {{ tokens.bg3 }} 100%);
}
.brand { color: #fff; }
.brand-dot { background: {{ tokens.accent }}; }
.time { color: {{ tokens.muted }}; }
.label { background: {{ tokens.hot_bg1 }}; color: {{ tokens.accent }}; border: 1px solid {{ tokens.hot_border }}; }
.eyebrow { color: {{ tokens.accent }}; }
.title em { color: {{ tokens.accent }}; }
.sub { color: {{ tokens.muted }}; }
.footer { color: {{ tokens.text_dim }}; }
.footer-r { color: {{ tokens.accent }}; }
.bg-glow-tr { background: radial-gradient(circle, {{ tokens.hot_bg1 }}, transparent 70%); }
.bg-glow-bl { background: radial-gradient(circle, {{ tokens.hot_bg2 }}, transparent 70%); }
.bg-watermark { color: {{ tokens.accent }}; }
{% block style %}{% endblock %}
  </style>
</head>
<body>
<div class="card">
  <span class="bg-glow bg-glow-tr"></span>
  <span class="bg-glow bg-glow-bl"></span>
  <span class="bg-watermark">★</span>
{% block content %}{% endblock %}
  <div class="footer">
    <span>@stockrise_kr</span>
    <span class="footer-r">stockrise.vercel.app</span>
  </div>
  <div class="disclaimer">정보 제공 · 매매 권유 아님 · 유사투자자문업 미신고</div>
</div>
</body>
</html>
