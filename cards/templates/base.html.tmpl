{#
  공통 골격 — 통일 헤더(좌상 라벨 + 우상 날짜) + 우하단 URL.
  자식 템플릿은 {% block style %}, {% block content %} 만 채움.
#}
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>StockRise · {{ data.date_full }} · {{ data.series }}</title>
  <link rel="stylesheet" as="style" crossorigin
        href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
  <style>
{% include "_base.css" %}
/* 시리즈별 컬러 토큰 주입 */
html, body {
  background: {{ tokens.bg1 }};
  background: linear-gradient(165deg,
    {{ tokens.bg1 }} 0%,
    {{ tokens.bg2 }} 50%,
    {{ tokens.bg3 }} 100%);
}
.card {
  background: linear-gradient(165deg,
    {{ tokens.bg1 }} 0%,
    {{ tokens.bg2 }} 50%,
    {{ tokens.bg3 }} 100%);
}
.card-label { background: {{ tokens.hot_bg1 }}; color: {{ tokens.accent }}; border: 1px solid {{ tokens.hot_border }}; }
.card-date { color: {{ tokens.muted }}; }
.card-url { color: {{ tokens.accent }}; }
.title em { color: {{ tokens.accent }}; }
.bg-glow-tr { background: radial-gradient(circle, {{ tokens.hot_bg1 }}, transparent 70%); }
.bg-glow-bl { background: radial-gradient(circle, {{ tokens.hot_bg2 }}, transparent 70%); }
.bg-watermark { color: {{ tokens.accent }}; }
{% block style %}{% endblock %}
  </style>
</head>
<body>
<div class="card">
  <span class="bg-glow bg-glow-tr"></span>
  <span class="bg-glow bg-glow-bl"></span>
  <span class="bg-watermark">★</span>
  <header class="card-header">
    <span class="card-label">{{ data.label }}</span>
    <span class="card-date">{{ data.date_full }}</span>
  </header>
{% block content %}{% endblock %}
  <span class="card-url">stockrise.vercel.app</span>
</div>
</body>
</html>
