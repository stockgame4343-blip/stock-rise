{% extends "base.html.tmpl" %}
{% block style %}
/* 대장주 = 한 종목 초대형 강조. 점수 박스 제거 (카드뉴스답지 않음) */
.title { font-size: 110px; }
.sub { margin-top: 16px; font-size: 26px; }
.theme-badge {
  display: inline-block;
  margin-top: 56px;
  padding: 14px 28px;
  background: {{ tokens.accent }};
  color: {{ tokens.bg1 }};
  font-size: 28px;
  font-weight: 900;
  border-radius: 12px;
  letter-spacing: -0.01em;
  align-self: flex-start;
  position: relative;
  z-index: 2;
}
.stock-name {
  margin-top: 28px;
  font-size: 180px;
  font-weight: 900;
  letter-spacing: -0.05em;
  line-height: 0.9;
  position: relative;
  z-index: 2;
}
.stock-meta { margin-top: 18px; font-size: 26px; color: {{ tokens.muted }}; font-weight: 700; position: relative; z-index: 2; }
.stock-rate {
  margin-top: 28px;
  display: flex;
  align-items: center;
  gap: 24px;
  position: relative;
  z-index: 2;
}
.stock-rate-num { font-size: 156px; font-weight: 900; color: {{ tokens.accent2 }}; letter-spacing: -0.05em; line-height: 1; }
.stock-ceiling {
  font-size: 28px;
  font-weight: 900;
  color: {{ tokens.accent }};
  padding: 10px 20px;
  background: {{ tokens.hot_bg1 }};
  border: 2px solid {{ tokens.hot_border }};
  border-radius: 12px;
}
.why {
  margin-top: 40px;
  padding: 28px 36px;
  background: {{ tokens.card_bg }};
  border-left: 6px solid {{ tokens.accent }};
  border-radius: 16px;
  font-size: 26px;
  color: #fff;
  line-height: 1.45;
  font-weight: 700;
  position: relative;
  z-index: 2;
}
{% endblock %}

{% block content %}
<div class="top">
  <div class="brand"><span class="brand-dot"></span>StockRise</div>
  <div class="time">{{ data.time_text }}</div>
</div>
<div class="eyebrow">{{ data.eyebrow }}</div>
<h1 class="title"><em>{{ data.title_em }}</em></h1>

<span class="theme-badge">★ {{ data.badge_theme }}</span>
<div class="stock-name">{{ data.name }}</div>
<div class="stock-meta">{{ data.code }} · {{ data.market }}</div>
<div class="stock-rate">
  <span class="stock-rate-num">{{ "%+.2f"|format(data.rate) }}%</span>
  {% if data.is_limit_up %}<span class="stock-ceiling">▲ 상한가</span>{% endif %}
</div>

<div class="why">{{ data.why_text }}</div>
{% endblock %}
